<Window x:Class="pr7_wpf_converts_Trembach.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr7_wpf_converts_Trembach"
        xmlns:models="clr-namespace:pr7_wpf_converts_Trembach.Models"
        xmlns:converters="clr-namespace:pr7_wpf_converts_Trembach.Converters"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="600">
    <Window.Resources>
        <converters:PriceConverter x:Key="PriceConv"/>
        <converters:LowStockConverter x:Key="LowStockConv"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="5" Background="Pink">
            <TextBlock Text="Название" Margin="10"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
            <TextBlock Text="Цена (в копейках)" Margin="10"/>
            <TextBox Text="{Binding UnitPrice, Converter={StaticResource PriceConv}, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
            <TextBlock Text="Количество" Margin="10"/>
            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
            <TextBlock Text="Мин. остаток" Margin="10"/>
            <TextBox Text="{Binding MinimumStock, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="5" Background="Aqua">
            <TextBlock Text="Название:" Margin="10"/>
            <TextBlock Text="{Binding Name}" Margin="10,0,0,0"/>
            <TextBlock Text="Цена:" Margin="10"/>
            <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:C}}" Margin="10,0,0,0"/>
            <TextBlock Text="Количество:" Margin="10"/>
            <TextBlock Text="{Binding Quantity, StringFormat={}{0:N0}}" Foreground="{Binding IsLowStock, Converter={StaticResource LowStockConv}}" Margin="10,0,0,0"/>
            <TextBlock Text="Общая стоимость:" Margin="10"/>
            <TextBlock Text="{Binding TotalValue, StringFormat={}{0:C}, ConverterCulture=ru-RU}" Margin="10,0,0,0" FontSize="16"/>
        </StackPanel>
    </Grid>
</Window>
